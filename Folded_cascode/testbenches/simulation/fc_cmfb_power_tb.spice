**.subckt fc_cmfb_power_tb_batch
x1 VDDA_OTA VSSA Vinp Vinn voutp Vb1 voutn Vb1 Vb3 Vb4 Vb5 folded_cascode
x2 VDDA_CMFB VSSA voutp voutn Balance_Level Vb1 Vb4 Vb6 cmfb
C1 voutn VSSA 20p
C2 voutp VSSA 20p
V1 VDDA VSSA VDDA
V3 VSSA 0 0
V5 Vb1 VSSA Vb1
V6 Vb3 VSSA Vb3
V4 Balance_Level VSSA Balance_Level
* noconn Vb4
E1 Vout VSSA voutp voutn 1
* noconn Vout
Bvinp Vinp VSSA V = {VCM + V(Vdiff)/2}
Bvinn Vinn VSSA V = {VCM - V(Vdiff)/2}
Vdiff Vdiff VSSA 0
Vamm2 VDDA VDDA_CMFB 0
.save i(vamm2)
Vamm1 VDDA VDDA_OTA 0
.save i(vamm1)
V8 Vb5 VSSA Vb5
V7 Vb6 VSSA Vb6
**** begin user architecture code

.include /usr/local/share/OpenPDKs/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /usr/local/share/OpenPDKs/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical



.temp 27
.param VDDA = 5
.param Balance_Level = 1.3
.param Vb1 = 3.96
.param Vb3 = 3.6
.param Vb5 = 0.72
.param Vb6 = 0.83
.param VD = 0
.param VCM = 2.5

.param sw_stat_global=0
