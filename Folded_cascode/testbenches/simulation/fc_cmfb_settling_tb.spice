* ============================================================
* SETTLING TIME ANALYSIS
*
* Closed-loop differential configuration
*
* Vcmd:
*   -0.8 V -> +0.8 V at 5 us
*   +0.8 V -> -0.8 V at ~25 us
*
* Settling criteria will be evaluated externally:
*
*   +/-1 %
*   +/-0.1 %
* ============================================================


* ------------------------------------------------------------
* Operating point
* ------------------------------------------------------------

op

write fc_cmfb_settling_op_tb.raw


* ------------------------------------------------------------
* Transient simulation
*
* 1 ns max timestep gives better resolution than the
* 10 ns step used for the slew-rate extraction.
* ------------------------------------------------------------

tran 1n 45u


* ------------------------------------------------------------
* Quantities
* ------------------------------------------------------------

let vod = v(voutp)-v(voutn)
let vocm = (v(voutp)+v(voutn))/2

let tracking_error = vod-v(Vcmd)


* ------------------------------------------------------------
* Save raw transient
* ------------------------------------------------------------

write fc_cmfb_settling_tb.raw


* ------------------------------------------------------------
* Export for Python post-processing
*
* Columns:
*
* time
* Vcmd
* Vod
* Voutp
* Voutn
* Vocm
* tracking_error
* ------------------------------------------------------------

wrdata settling.dat v(Vcmd) vod v(voutp) v(voutn) vocm tracking_error


* ------------------------------------------------------------
* Diagnostic plots
* ------------------------------------------------------------

plot v(Vcmd) vod
plot tracking_error
plot v(voutp) v(voutn)
plot vocm

.endc


