** sch_path: /home/juan/realhome/Documents/gf180/2026_chipalooza/fully_diff_FC/testbenches/top_fc_offset_tb.sch
**.subckt top_fc_offset_tb
Vdiff vdiff_node VSSA 0
V1 VDDA VSSA VDDA
V3 VSSA 0 0
V4 Balance_Level VSSA Balance_Level
Bvinp Vinp VSSA V = {VCM+V(vdiff_node)/2}
Bvinn Vinn VSSA V = {VCM-V(vdiff_node)/2}
x1 Balance_Level Vinp voutp VDDA voutn Vinn Iref VSSA top_fc
C1 voutn VSSA 20p
C2 voutp VSSA 20p
I0 Iref VSSA 1u
**** begin user architecture code

.include /usr/local/share/OpenPDKs/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /usr/local/share/OpenPDKs/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical



.temp 27

.param VDDA=5
.param Balance_Level=1.3
.param vcm = 2.5

* Monte Carlo mismatch only
.param sw_stat_global=0
.param sw_stat_mismatch=1

.control

let run = 0
let nrun = 250

shell rm -f vos_mc.txt

while run < nrun

    reset

    dc Vdiff -20m 20m 10u

    let vod = v(voutp)-v(voutn)

    meas dc vos WHEN vod=0 CROSS=1

    echo $&vos >> vos_mc.txt

    let run = run + 1

end

.endc


**** end user architecture code
**.ends

