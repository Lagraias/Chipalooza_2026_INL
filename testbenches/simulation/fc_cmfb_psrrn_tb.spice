**.subckt fc_cmfb_psrrn_tb
x1 VDDA VSSA Vin Vin voutp Vb1 voutn Vb1 Vb3 Vb4 Vb5 folded_cascode
x2 VDDA VSSA voutp voutn Balance_Level Vb1 Vb4 Vb6 cmfb
V2 Vin 0 2.5
C1 voutn VSSA 20p
C2 voutp VSSA 20p
V1 VDDA 0 dc VDDA ac 0
V3 VSSA 0 dc 0 ac 1
V5 Vb1 0 dc Vb1 ac 0
V6 Vb3 0 dc Vb3 ac 0
V4 Balance_Level 0 dc Balance_Level ac 0
* noconn Vb4
E1 Vout VSSA voutp voutn 1
* noconn Vout
V8 Vb5 VSSA dc Vb5 ac 0
V7 Vb6 VSSA dc Vb6 ac 0
**** begin user architecture code

.include /usr/local/share/OpenPDKs/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /usr/local/share/OpenPDKs/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical



.temp 27
.param VDDA = 5
.param Balance_Level = 1.3
.param Vb1 = 3.96
.param Vb3 = 3.6
.param Vb5 = 0.72
.param Vb6 = 0.83
.param VD = 0

.param sw_stat_global=0
.param sw_stat_mismatch=0

.control
option sparse
set filetype=ascii
set wr_singlescale
set wr_vecnames
save all
save @m.x1.xm1.m0[id]
save @m.x1.xm1.m0[gm]
